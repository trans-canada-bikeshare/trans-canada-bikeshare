{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exclusions.schema.json",
  "title": "exclusions",
  "description": "Contract for src/data/generated/exclusions.json. Validated at publish time by pipeline/artifact_schemas.py and in vitest by src/schemas.test.ts, so a publisher change the site does not expect fails at the gate rather than in a browser.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "system_id": {
        "type": "string",
        "enum": [
          "mtl-bixi",
          "tor-bikeshare",
          "van-mobi"
        ]
      },
      "unterminated": {
        "type": "integer",
        "minimum": 0
      },
      "station_matched_by_name": {
        "type": "integer",
        "minimum": 0
      },
      "total": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "station_matched_by_name",
      "system_id",
      "total",
      "unterminated"
    ]
  }
}
