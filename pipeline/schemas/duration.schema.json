{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "duration.schema.json",
  "title": "duration",
  "description": "Contract for src/data/generated/duration.json. Validated at publish time by pipeline/artifact_schemas.py and in vitest by src/schemas.test.ts, so a publisher change the site does not expect fails at the gate rather than in a browser.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "system_id": {
        "type": "string",
        "enum": [
          "mtl-bixi",
          "tor-bikeshare",
          "van-mobi"
        ]
      },
      "median_s": {
        "type": "integer",
        "minimum": 0
      },
      "p25_s": {
        "type": "integer",
        "minimum": 0
      },
      "p75_s": {
        "type": "integer",
        "minimum": 0
      },
      "basis_trips": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "basis_trips",
      "median_s",
      "p25_s",
      "p75_s",
      "system_id"
    ]
  }
}
