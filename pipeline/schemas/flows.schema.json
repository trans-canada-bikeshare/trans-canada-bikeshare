{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flows.schema.json",
  "title": "flows",
  "description": "Contract for src/data/generated/flows.json. Validated at publish time by pipeline/artifact_schemas.py and in vitest by src/schemas.test.ts, so a publisher change the site does not expect fails at the gate rather than in a browser.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "top_pairs_shown": {
      "type": "integer",
      "minimum": 1
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "system_id": {
            "type": "string",
            "enum": [
              "mtl-bixi",
              "tor-bikeshare",
              "van-mobi"
            ]
          },
          "pairs_total": {
            "type": "integer",
            "minimum": 0
          },
          "linked_trips": {
            "type": "integer",
            "minimum": 0
          },
          "shown_trips": {
            "type": "integer",
            "minimum": 0
          },
          "top_10": {
            "type": "integer",
            "minimum": 0
          },
          "top_100": {
            "type": "integer",
            "minimum": 0
          },
          "top_1000": {
            "type": "integer",
            "minimum": 0
          },
          "round_trips": {
            "type": "integer",
            "minimum": 0
          },
          "no_return_station": {
            "type": "integer",
            "minimum": 0
          },
          "trips": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "linked_trips",
          "no_return_station",
          "pairs_total",
          "round_trips",
          "shown_trips",
          "system_id",
          "top_10",
          "top_100",
          "top_1000",
          "trips"
        ]
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "s": {
            "type": "string",
            "enum": [
              "mtl-bixi",
              "tor-bikeshare",
              "van-mobi"
            ]
          },
          "a": {
            "type": "string",
            "minLength": 1
          },
          "b": {
            "type": "string",
            "minLength": 1
          },
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "r": {
            "type": "boolean"
          }
        },
        "required": [
          "a",
          "b",
          "n",
          "r",
          "s"
        ],
        "description": "s system, a and b the named endpoints, n trips, r round trip."
      }
    }
  },
  "required": [
    "pairs",
    "systems",
    "top_pairs_shown"
  ]
}
