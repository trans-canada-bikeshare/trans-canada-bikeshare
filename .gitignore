# dependencies
node_modules/
.venv/

# raw source data and warehouse are never committed
data-raw/
data-warehouse/

# build output
dist/

# tooling artifacts
.playwright-mcp/
playwright-report/
__pycache__/
*.pyc
.DS_Store

# test + build tooling
coverage/
.vite/

# `make check-fixture`'s scratch tree: a copy of the synthetic fixture archive,
# the warehouse built from it, and the artifacts published from that. Removed on
# success; kept by `--keep` for inspection. The fixture SOURCE files are
# committed, under pipeline/tests/fixtures/.
.fixture-run/

# agent worktrees and local claude state
.claude/worktrees/

# Trailing-slash entries do not match SYMLINKS with these names. Agent
# worktrees symlink the shared archive and venv into their checkouts, and
# without these no-slash twins a `git add -A` there stages the symlink into a
# repository whose first invariant is that raw data never enters git.
data-raw
data-warehouse
.venv
